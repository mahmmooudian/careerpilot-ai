# Phase 2: external AI is opt-in for each /analyze request.
# Never commit/share .env. Do not paste your key into chat.
AI_API_KEY=YOUR_API_KEY_HERE
AI_BASE_URL=https://api.groq.com/openai/v1
# Current Groq model; can use any provider/model supporting chat completions JSON mode.
AI_MODEL=openai/gpt-oss-120b
# OpenAI alternative: AI_BASE_URL=https://api.openai.com/v1
# OpenAI alternative: AI_MODEL=gpt-4o-mini

# Phase 3.1: public job discovery (read-only)
JOB_REMOTIVE_ENABLED=true
# Optional: verified employers only; comma-separated board/site slugs (not URLs)
JOB_GREENHOUSE_BOARDS=
JOB_LEVER_SITES=
JOB_ASHBY_BOARDS=
